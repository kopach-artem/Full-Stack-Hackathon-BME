    "test:e2e:student": "playwright test tests/e2e/student-flow.spec.ts",
    "test:e2e:student:headed": "playwright test tests/e2e/student-flow.spec.ts --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  },
  "packageManager": "pnpm@10.0.0"
